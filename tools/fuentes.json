            "2026"
          ],
          "columnas": {
            "A": "fecha",
            "B": "stock anterior",
            "C": "consumo",
            "D": "ingreso",
            "E": "stock final"
          },
          "cuenta": "Suma de la columna CONSUMO por mes, sólo filas con fecha de 2026. Se cargan únicamente los meses que ya existen en RESUMEN.meses, que los define el presupuesto."
