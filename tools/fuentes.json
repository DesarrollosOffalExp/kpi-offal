  "descargas": "C:/Users/admin/Downloads",
  "grupos": {
    "fabrica-hielo": {
      "carpeta": "Gerencia de Operaciones/Fábrica de Hielo",
      "extractor": "fabrica-hielo",
      "fuentes": [
        {
          "id": "pallets",
          "archivo": "MOVIMIENTO DE PALLETS.xlsx",
          "destino": "client/src/dashboards/movimiento-pallets.html",
          "constante": "WEEKS",
          "hojas": "una por semana; el nombre de la hoja es la etiqueta de la semana",
          "columnas": {
            "A": "frigorífico",
            "B": "deuda",
            "C": "enviados",
            "D": "recibidos",
            "E": "no devueltos"
          },
          "cuenta": "Una fila por frigorífico. El total de la semana NO se suma: sale de la fila STOCK FINAL de la propia planilla. Se descartan las filas de encabezado y RESULTADO."
        },
        {
          "id": "productividad",
          "archivo": "PRODUCTIVIDAD BARRAS.xlsx",
          "destino": "client/src/dashboards/productividad-barras.html",
          "constante": "DATA",
          "hojas": [
            "RESUMEN",
            "HISTORICO"
          ],
          "columnas": {
            "A": "día",
            "B": "fecha",
            "C": "personal",
            "D": "barras producidas",
            "E": "hombre/barra día",
            "F": "horas",
            "G": "hom/barra hs",
            "H": "consumo"
          },
          "cuenta": "Los días con dato arman la serie de la semana; la fila RESUMEN arma los KPI de cabecera. HISTORICO (semana, promedio) alimenta la tendencia anual."
        },
        {
          "id": "monitoreo",
          "archivo": "MONITOREO DE BARRAS  DEL <rango>.xlsx",
          "destino": "client/src/dashboards/monitoreo-barras.html",
          "constante": "SEMANAS",
          "hojas": "la primera hoja del archivo (una por semana, un archivo por semana)",
          "columnas": {
            "C": "viajes",
            "D": "proveedor",
            "E": "kilos",
            "F": "REMONTADO (texto)",
            "G": "kgs x tambor",
            "H": "tachos estimados",
            "I": "tachos enviados",
            "J": "barras estimadas",
            "K": "dif de barras",
            "L": "barras enviadas",
            "M": "barras vendidas",
            "N": "devolución",
            "O": "barras usadas",
            "P": "enfriar",
            "Q": "stock anterior",
            "R": "stock",
            "S": "promedio estimado",
            "T": "promedio enviados",
            "V": "valor barra",
            "X": "costo x kg"
