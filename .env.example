# ==========================================================================
#  kpi-offal — variables de entorno
# ==========================================================================

# --- Base de datos compartida (padrón acceso) ---
# Mismas credenciales que las otras apps (base controletiquetas).
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=1433
DB_ENCRYPT=true

# --- Desarrollo local ---
# Email con el que se simula el login cuando no hay Easy Auth delante.
DEV_EMAIL=roberto.sanabria@offal.com.ar

# Exigir permiso 'kpi' en el padrón (acceso.Permisos) para ver el tablero.
# Dejar en false hasta que se cargue la app 'kpi' en el padrón; luego true.
KPI_REQUIRE_PERMISSION=false

# --- Microsoft Graph (lectura del KPI.xlsx en SharePoint) ---
# App registration con permiso de APLICACIÓN Sites.Selected (o Files.Read.All)
# + consentimiento de admin. Lo habilita el inge/admin del tenant.
# Si CUALQUIERA de estas falta, el tablero usa datos MOCK (para desarrollo).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# URL de compartir del archivo (la que te dio SharePoint: .../Doc.aspx?...file=KPI.xlsx...)
KPI_FILE_SHARE_URL=

# Cada cuántos segundos se refresca la lectura del Excel (cache en memoria).
KPI_CACHE_TTL_SECONDS=300
